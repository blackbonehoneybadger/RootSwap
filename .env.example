# ==============================================================================
# RootSwap environment configuration (example)
# Copy to .env and fill in. NEVER commit .env or real secrets.
# ==============================================================================

# --- Core ---------------------------------------------------------------------
# development | staging | production | test
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Database / cache ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://rootswap:rootswap@localhost:5432/rootswap
REDIS_URL=redis://localhost:6379/0
# Required in production:
REDIS_PASSWORD=
POSTGRES_PASSWORD=

# --- Secrets (production refuses to start with weak/missing values) ------------
# Min 32 random chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Fernet key. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# HMAC secret shared with partner webhooks (per-partner secrets when real partners arrive)
PARTNER_WEBHOOK_SECRET=

# --- Telegram -------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=RootSwapBot
BOT_USERNAME=RootSwapBot
# Public URL of the Mini App (Telegram requires HTTPS)
MINI_APP_URL=
# Dev only, never in production: skip initData signature verification
TELEGRAM_AUTH_INSECURE_SKIP=false

# --- Partner gates ---------------------------------------------------------------
# MUST both be false in production. Mock/sandbox never move real funds.
ALLOW_MOCK_PARTNERS=true
ALLOW_SANDBOX_PARTNERS=true

# --- Fees / referral --------------------------------------------------------------
SERVICE_FEE_PERCENT=0.9
REFERRAL_REWARD_BASIS=service_fee
REFERRAL_REWARD_PERCENT=20

# --- Timeouts / workers -------------------------------------------------------------
QUOTE_TTL_SECONDS=120
PAYMENT_INSTRUCTIONS_TTL_SECONDS=900
QUOTE_PARTNER_TIMEOUT_SECONDS=3.0
POLLING_ENABLED=true
POLLING_INTERVAL_SECONDS=15
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# --- Rate limiting -------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Auth sessions (JWT access token + rotating refresh cookie) ----------------------
# Short-lived access token (kept in memory client-side); long-lived opaque refresh
# token (HttpOnly cookie, only its SHA-256 hash stored server-side).
JWT_TTL_SECONDS=900
JWT_ISSUER=rootswap
JWT_AUDIENCE=rootswap-miniapp
REFRESH_TTL_SECONDS=2592000
# Cookies MUST be Secure in any real deployment (Telegram runs over HTTPS). Set
# false ONLY for local http testing. SameSite=none is required for the Telegram
# webview (cross-site); Secure is mandatory whenever SameSite=none.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# --- Web ----------------------------------------------------------------------------
# Credentialed CORS: must be an explicit origin list (never "*") so the browser
# sends the refresh cookie. Include your Mini App origin here.
CORS_ORIGINS=http://localhost:5173
PUBLIC_ORIGIN=

# --- Admin RBAC (JSON: telegram_id -> SUPPORT|OPERATIONS|FINANCE|ADMIN) ---------------
ADMIN_TELEGRAM_IDS={}

# --- Notifications ---------------------------------------------------------------------
NOTIFICATIONS_ENABLED=false
