# RootSwap Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# --- General ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://rootswap:rootswap@localhost:5432/rootswap
POSTGRES_USER=rootswap
POSTGRES_PASSWORD=rootswap
POSTGRES_DB=rootswap

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --- Security (CHANGE IN PRODUCTION) ---
JWT_SECRET=rootswap-dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=rootswap
JWT_AUDIENCE=rootswap-mini-app
ENCRYPTION_KEY=dev-encryption-key-32bytes-long!!
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret
WEBHOOK_SECRET=dev-partner-webhook-secret
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
MAX_REQUEST_BODY_BYTES=65536
TRUSTED_PROXY_IPS=

# DEV endpoints (/auth/dev, /orders/{id}/simulate-payment). Default false.
# Must stay false in production (forced off by config).
ENABLE_DEV_ENDPOINTS=true
ENABLE_MOCK_PARTNERS=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=0000000000:DEV_TELEGRAM_BOT_TOKEN_PLACEHOLDER
MINI_APP_URL=http://localhost:5173

# --- Admin ---
ADMIN_API_KEYS=ADMIN:dev-admin-key

# --- CORS (comma-separated; never * in production) ---
CORS_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- Business ---
SERVICE_FEE_RATE=0.015
REFERRAL_REWARD_RATE=0.25
REFERRAL_REWARD_BASIS=service_fee
QUOTE_TTL_SECONDS=300
PAYMENT_INSTRUCTIONS_TTL_SECONDS=900
POLLING_INTERVAL_SECONDS=30
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
PARTNER_QUOTE_TIMEOUT_SECONDS=5.0
RATE_LIMIT_PER_MINUTE=60
EMERGENCY_STOP=false

# --- Mini App ---
VITE_API_URL=http://localhost:8000/api
# Browser DEV auth fallback (Vite only; ignored in production builds)
VITE_ENABLE_DEV_AUTH=true
